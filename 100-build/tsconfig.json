{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    // ? 100.4.0 Итак, если мы начнём менять модуль, а потом проверять, что у нас компилируется в итоговый файл, то увидим явную разницу, в то время, как в CommonJS мы увидим типичные "require" импорты (и, как мы уже говорили — этот тип модульности более типичен для бэкенда), то в "ES6" всё останется также, как мы делали импорт/экспорт в TypeScript. Но вот только появилась одна проблема — теперь, когда мы пробуем запустить JS-файл "index.js", то у нас выскакивает ошибка. И дело тут в том, что для того, чтобы работать с "ES6" нам нужно в файле "package.json" прописать: "type": "module".
    // ? 100.4.1 Но ошибка никуда не делась, а всё из-за того, что при импорте файлов мы не указали его расширение (и это очень распространённая ошибка фронтендеров, т.к. сборщики чаще всего не требуют расширений и дописывают это за нас).
    // (Go to [100-build/src/index.ts])
//    "module": "CommonJS",
    "module": "ES6",
    "target": "es2020",
    //    "target": "esnext",
    //    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // Other Outputs
    //    "sourceMap": true,
    //    "declaration": true,
    //    "declarationMap": true,

    // Stricter Typechecking Options
    //    "noUncheckedIndexedAccess": true,
    //    "exactOptionalPropertyTypes": true,

    "strictPropertyInitialization": false,
    // Для того чтобы снять TS-ошибки при использовании более нового синтаксиса полей классов в TypeScript
    //    "experimentalDecorators": true, // Поменять, если есть ошибка с синтаксисом декораторов в TypeScript
    //    "emitDecoratorMetadata": true,  // Позволяет работать с метаданными

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    //    "jsx": "react-jsx",
    //    "verbatimModuleSyntax": true,
    //    "isolatedModules": true,
    //    "noUncheckedSideEffectImports": true,
    //    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
