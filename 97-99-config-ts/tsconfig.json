{
  // Visit https://aka.ms/tsconfig to read more about this file
  /*"files": [
    "index.ts",
    "test.ts"
  ],*/
  // ? 97.2.1 Но так вот указывать путь к каждому файлу тоже не слишком удобно, гораздо проще было бы указать директорию/-ии с файлами. Для этого есть другая опция "include", которая занимается тем же, что и "files", но при этом позволяет создавать паттерны. Итак, допустим у нас есть две директории с TS-файлами — "src" и "test", тогда пути мы можем прописать так:
  // ? 97.2.2 Стоит отметить, что когда мы указываем такой путь без расширения файла, то TS, следующий этому конфигу возьмёт из этих папок все файлы с расширениями: ".ts", ".tsx", ".dts". А если включить ещё одну настройку, то также ".js" и ".jsx". ↓
  "include": [
    "src/**/*",
    "src/test/**/*"
  ],
  // ? 97.4 Мы можем также исключать определённые файлы/папки, которые находятся внутри настроек "include", но нужно убрать из компиляции при помощи опции "exclude". Однако, тут стоит помнить, что если эти файлы, которые мы хотим исключить попали (путём импорта) в другие включённые в компиляцию файлы, то они всё равно останутся в компиляции.
  "exclude": [
    "src/temp/**/*"
  ],
  // ? 97.5 Ещё есть опция топ-уровня "extends", которая позволит данному конфигу унаследовать настройку другого конфига (т.е. быть дополненным отсутствующими здесь настройками, но встречается довольно редко).
  "compilerOptions": {
    // ? 97.3.0 Ну, и раз уж мы об этом упомянули, то сразу посмотрим на его одну опцию "allowJs", которая позволит добавлять в компиляцию также JS-файлы. (Особенно могут быть полезны при миграции одного проекта в другой.) ↑
    "allowJs": true,
    // ? 97.3.1 Также есть ещё опция "checkJs", которая отвечает за проверку на ошибки JS-файлов.
    "checkJs": true,
    // File Layout
    // ? 97.6 Рассмотрим ещё две опции самого компилятора "rootDir" & "outDir", которые указываю где у нас будет находиться корневая директория и куда будут складываться скомпилированные JS-файлы
    // Go to [/notes/97-config-files-input-n-output.md]
    // "rootDir": "./src",
    "outDir": "./dist",
    // ? 98.0 Продолжаем изучать опции компилятора TypeScript и на очереди опция, которая удалит все комментарии из итогового файла "removeComments"
    "removeComments": true,
    // ? 98.1 Ещё одна опция "noEmit" используется довольно редко. Она отключает компиляцию, оставляя лишь проверку.
    //    "noEmit": true,
    // ? 98.2 В отличие от предыдущей опции "noEmitOnError включают довольно часто. Она позволяет отключать компиляцию, если есть ошибки. Т.е. без этой опции даже при наличии ошибок всё равно будет создаваться итоговый JS-файл.
    "noEmitOnError": true,
    // ? 98.3 Опция "noEmitHelpers" позволяет настроить контроль за эмитированием вспомогательных функций (например таких, как "__decorate()" при использовании функций-декораторов). Включается крайне редко, т.к. в таком случае обязывает разработчика предоставить свою версию реализации этих функций в JS-коде.
    //    "noEmitHelpers": true,
    // ? 98.4 Следующая опция позволит импортировать функции-помощники глобально, а не в каждый отдельный файл. Это позволит немного сэкономить на размере итогового файла, но стоит также учитывать настройки общего сборщика проекта, чтобы не возникло конфликтов.
    "importHelpers": true,
    // ? 98.5 Эта опция работает с функцией удаления типов при импорте. При работе с проектами у нас могут быть различные импортируемые в другие файлы типы. По умолчанию они удаляются при компиляции, но можно настроить, чтобы они сохранялись для специфических задач. (Используется редко, т.к. есть и другие средства, о которых будет далее.)
    //    "importsNotUsedAsValues": "remove",
    // ? 98.6.0 Если нам нужно обеспечить связь между файлами TypeScript и JavaScript, то для этого удобно использовать карту исходников ("source map", работающие по тому же принципу, что и в CSS), чтобы в случае возникновения ошибок знать в каком именно файле произошла ошибка. Если включить эту опцию, то при компиляции к каждому JS-файлу будут также создавать файлы карт исходников, которые могут сильно помочь в поиске ошибок при дебаггинге. Это довольно стандартная опция и многие держат её включённой.
    "sourceMap": true,
    // ? 98.6.1 Но есть и альтернативный вариант — включать карту исходников в сам JS-файл. (В целом эта опция используется гораздо реже предыдущей)
    //        "inlineSourceMap": true,
    // ? 98.7 Опция "inlineSources" добавит в итоговые JS-файлы все исходники TS-файлов (что, конечно же, существенно увеличит их размер и в продакшене обычно не используется, особенно на фронтенде).
    //        "inlineSources": true,
    // ? 98.8 Следующие две опции "mapRoot" & "sourceRoot" позволяют установить пути, по которым дебагер будет искать карты исходников, если им отведено в архитектуре проекта особое место.
    //    "sourceRoot": "",
    //    "mapRoot": ",
    // ? 98.9.0 Продолжая двигаться в этом направлении установления связей между файлами TypeScript и JavaScript, стоит поговорить также про декларации. Используя разные библиотеки и фреймворки, написанные с поддержкой TypeScript можно часто встретить специальные файлы с расширением ".d.ts", в которых обычно описаны готовые типы и интерфейсы для использования. За генерацию подобных файлов отвечает специальная настройка "declaration". В этих сгенерированных файлах с расширением ".d.ts" будут описаны классы более абстрактно. Там будут описаны аннотации функций или схемы, которые не ведут к каким-то конкретным действиям (по аналогии с "перегрузкой функций"). Ключевое слово "declare" указывает на то, что дальше описывается код из другого места. (См. примеры файлов [97-config-ts/types/src/queue.d.ts] & [97-config-ts/types/src/stack.d.ts])
    "declaration": true,
    // ? 98.9.1 Следующая опция включает генерацию карт исходников для таких файлов деклараций.
    "declarationMap": true,
    // ? 98.9.2 Опция "emitDeclarationOnly" включит режим генерации деклараций без JS-файлов. Зачем это может быть вообще нужно? Ну, например, в случае, если мы создали какой-то функционал, но хотим, в качестве готового кода предоставить лишь сущности для работы. Они будут в будущем использованы для создания JS-кода. Т.е. нам нужно передать не готовый код, а лишь описание каких-то классов, интерфейсов или чего-то ещё. (Часто эта опция применяется во вспомогательных библиотеках и в обычных проектах не требуется.)
    //    "emitDeclarationOnly": true,
    // ? 98.9.3 Для установления конкретной папки, где должны создаваться декларации есть опция "declarationDir" (обычно эту папку называют "types" или подобным образом). Это часто используется, т.к. это просто удобно отделять типы от прочих файлов. А также не редко встречаются в готовых решениях и библиотеках на TypeScript, что предлагается также установить их декларации.
    "declarationDir": "./types",
    // ? 98.9.4 Бывают также ситуации, когда мы не хотим добавлять в декларации какие-то определённые типы и эта опция поможет их исключить. Для этого над типом, который надо исключить прописывается комментарий "// @internal". Нужно быть аккуратным с этой настройкой, т.к. неосторожное исключение типа, связанного с другими типами какими-то зависимостями, может привести к ошибкам и неправильно работе.
    //    "stripInternal": true,
    // ? 98.10 Эта опция позволит сохранять конструкции "const enum" как объекты внутри JavaScript.
    //    "preserveConstEnums": true,
    // ? 98.11 Позволяет сохранять неиспользованные импорты, которые по умолчанию удаляются.
    //    "preserveValueImports": true,

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    // ? 99.3 Переходим к работе с модулями. Здесь настройки про то, какие файлы брать в работу, куда складывать итоговые файлы, как их преобразовывать и по какому стандарту мы вообще работаем. Опция "module" отвечает за то, какую модульную систему мы используем в проекте. "commonjs" чаще всего используют на бэкенд, "ES6" используют чаще на фронтенде (про это будет подробнее на следующем уроке).
    //    "module": "nodenext",
    "module": "commonjs",
    // ? 99.4.0 Следующая опция "rootDir" указывает путь к корневой папке исходных файлов. Часто это "src". При этом, хотя теперь компилятор TypeScript ориентируется на папку "src" он не создаёт папку "src" в "dist", а просто кидает в корень файлы оттуда.
    "rootDir": "./src",
    // ? 99.4.1 Есть довольно похожая опция "rootDirs", которая потребуется, если нам нужно объединить сразу несколько папок, чтобы они вели себя как одна корневая. Может использоваться, в случае, если надо дёргать разные файлы из разных папок или даже проектов.
    //    "rootDirs": ["", ""],
    // ? 99.5 Опция "baseUrl" позволит указать базовый путь при импортах. Т.е., благодаря этой опции теперь, чтобы записать импорт, например файлу в папке "test", то не нужно записывать "../../.." (условно), а мы уже находимся в самой верхней (корневой) папке. Однако, у такого подхода есть и минусы, например, если нужно импортировать что-то из соседнего файла, то нам всё равно придётся прописывать весь путь к нему из корня проекта. По этой причине, обычно эта функция не используется, кроме как случаев (как сказано в самой документации), когда мы работаем с загрузчиками модулей AMD* (*Загрузчик модулей AMD (Asynchronous Module Definition) — это подход и инструмент для асинхронной загрузки файлов и зависимостей в JavaScript. Главным и самым известным примером такого загрузчика является RequireJS.). И, в целом, не рекомендуется в другом контексте.
    "baseUrl": "./",
    // ? 99.6 А эта опция встречается часто. Она позволяет создать алиас пути. Такие подходы часто используют для фреймворка, чтобы получать короткие пути к компонентам, например.
    "paths": {
      "@": [
        "./src/components/"
      ],
      "test": [
        "./src/test/test.ts"
      ]
      // теперь можно будет просто прописать «import "test"» для импорта и т.п.
    },
    // ? 99.0 Опция "target" отвечает за версию стандарта TypeScript, которая поддерживается в проекте. "esnext" здесь означает самую свежую версию.
    "target": "es2020",
    //    "target": "esnext",
    // ? 99.7.0 Следующие две опции "types" и "typeRoots" помогают настроить работу с типами. "typeRoots" укажет TypeScript по какому пути искать доп. типы для устанавливаемых библиотек (по умолчанию стоит путь "./node_modules/@types").
    // ? 99.7.1 "types" — укажет типы, которые буду дополнять типизацию приложения
    "types": [],
    "typeRoots": [],
    // "types": ["node"],
    // and npm install -D @types/node
    // ? 99.8 Включение опции "resolveJsonModule" позволит импортирование JSON-файлов в код TypeScript и удобно их использовать. Почти всегда эта настройка будет включена. ↓
    "resolveJsonModule": true,
    // For nodejs:
    // ? 99.1.0 Опция "lib" отвечает за набор библиотек и API, которые будут включены в работу проекта. По умолчанию берутся те библиотеки, что указаны в стандарте, указанном в опции "target". Но может стоять задача, чтобы использовать лишь определённые возможности, к примеру, исключение работы с DOM-деревом на бэкенде. Ещё один пример — включение в работу той библиотеки и полифилла, которого нет ещё в стандарте. Для этого необходимо прописать это свойство и его значением указать массив строк, с указанием названий всех библиотек, которые мы хотим использовать в проекте или название какой-то коллекции.
    // "lib": ["esnext"],
    // ? 99.1.1 Опция "noLib" просто исключит все библиотеки из проекта.
    //    "noLib": true,
    // ? 99.2.0 Опция выбора каким способом будут обработаны JSX-файлы
    //    "jsx": "preserve",
    //    "jsx": "react-jsx",
    // ? 99.2.1 Также здесь отдельные опции указывающие как будут выглядеть фрагменты "" и элементы "jsxFactory":↑
    //    "jsxFactory": "React.createElement",
    //    "jsxFragmentFactory": "React.Fragment",

    // Other Outputs
    //    "sourceMap": true,
    //    "declaration": true,
    //    "declarationMap": true,
    // Stricter Typechecking Options
    // ? 99.10 Эта опция включает проверку, что если свойство объявлено не обязательным в интерфейсе, но при этом оно прописано в классе или объекте, то когда опция включена, то не получится назначить такому свойству значением undefined без TS-ошибки. Это логичное поведение и обычно в проектах она включена.
    "exactOptionalPropertyTypes": true,
    // Для того чтобы снять TS-ошибки при использовании более нового синтаксиса полей классов в TypeScript (позволяет создавать свойства в классе без их инициализации в конструкторе)
    "strictPropertyInitialization": false,
    // Поменять, если есть ошибка с синтаксисом декораторов в TypeScript
    "experimentalDecorators": true,
    // Позволяет работать с метаданными
    "emitDecoratorMetadata": true,
    // ? 99.11 Эта опция будет всегда записывать "use strict", включая режим повышенной строгости JS в каждый компилируемый JS-файл.
    //    "alwaysStrict": true,
    // ? 99.12 Опция при значении true будет выдавать TS-ошибку, если при написании конструкций "switch...case" мы забыли написать оператор "break" (см. [./97-config-ts/src/switch-case.ts]). Лишней в настройках не будет.
        "noFallthroughCasesInSwitch": true,
    // ? 99.13.0 Следующая опция также занимается доп. проверкой и также обычно включена в большинстве проектов. Когда мы обращаемся через индекс "object[0]" к какому-то свойству, например, и оно не находится, то вместо null, который ведёт к ошибкам мы получим undefined. (см. наглядный пример в файле [./97-config-ts/src/queue.ts])
    "noUncheckedIndexedAccess": true,
    // Style Options
    // "noImplicitReturns": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // ? 99.14 Ещё одна полезная опция, которая выдаст TS-ошибку, если мы попробуем получить доступ к несуществующему свойству через такой синтаксис "object[0]".
     "noPropertyAccessFromIndexSignature": true,
    // ? 99.15 Тут нужно вспомнить урок про темы наследования классов (см. [71-class-heritage.ts]). Эта опция не даёт в классах-наследниках перезаписывать методы с аналогичными названиями без использования модификатора "override". Т.е. когда названия методов повторяется в классе-родителе и классе-наследнике, то мы не сможем перезаписать функционал этого метода в классе-наследнике, не указав перед ним оператор "override". Опция также почти всегда включена в большинстве из проектов.
     "noImplicitOverride": true,
    // ? 99.16 Если эта опция включена, то TypeScript предупредит о коде, который никогда не будет выполнен (например в функции после return).
    "allowUnreachableCode": true,

    // Recommended Options
    // ? 99.9 Опция "strict" включает все проверки типизации, однако при необходимости некоторые можно выключать добавляя сюда со значением "false" (см. документацию). ↑
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
